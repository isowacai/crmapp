{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "set-admin": "node scripts/setAdmin.js",
    "list-users": "node scripts/listUsers.js",
    "sync-users": "node scripts/syncAuthUsers.js",
    "load-services": "node scripts/loadServiceCatalog.js",
    "test": "vitest run",
    "test:rules": "node tests/emulator.mjs \"vitest run --config vitest.rules.config.ts\"",
    "test:migration": "node tests/emulator.mjs \"node tests/migration/e2e.mjs\"",
    "migrate:teams": "node scripts/migrations/001-teams-and-pipeline.js",
    "check-rules-readiness": "node scripts/checkBeforeRules.js",
    "backup-data": "node scripts/backupData.js",
    "seed-sample-data": "vite-node scripts/seedSampleData.ts --"
  },
  "dependencies": {
    "firebase": "^10.8.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@tailwindcss/forms": "^0.5.7",
    "@types/node": "^20.11.24",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^13.35.1",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
